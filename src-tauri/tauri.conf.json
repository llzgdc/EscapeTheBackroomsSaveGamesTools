{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ETB Save Manager",
  "version": "3.4.2",
  "identifier": "com.admin.etbsavemanager",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ETB Save Manager",
        "width": 1280,
        "height": 720,
        "decorations": false,
        "additionalBrowserArgs": "--disable-software-rasterizer --enable-gpu-rasterization --force-gpu-rasterization",
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' https://github.com https://api.github.com https://objects.githubusercontent.com; script-src 'self';"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "webviewInstallMode": {
        "silent": true,
        "type": "embedBootstrapper"
      },
      "nsis": {
        "languages": [
          "English",
          "SimpChinese",
          "TradChinese"
        ],
        "displayLanguageSelector": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
